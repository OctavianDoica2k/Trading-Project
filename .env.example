# Copiază acest fișier ca .env și completează-l. Fișierul .env rămâne doar pe PC-ul tău.

# --- Server web ---
# 0.0.0.0 = accesibil și de pe telefon din aceeași rețea; 127.0.0.1 = doar de pe acest PC
HOST=0.0.0.0
PORT=8000

# --- Sursa prețurilor: QuestDB de pe mașina virtuală (VM) ---
# Adresa VM-ului în Tailscale și utilizatorul / parola QuestDB (http.user / pg.user din server.conf).
QUESTDB_HOST=
QUESTDB_USER=
QUESTDB_PASSWORD=

# --- cTrader Open API (doar pentru colectorul de pe VM și ctrader_setup.py) ---
# Creează o aplicație la https://openapi.ctrader.com/apps (logat cu cTrader ID-ul tău) și copiază
# aici Client ID și Secret.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# --- Login cu parolă (doar pe VM, unde serverul e public prin Tailscale Funnel) ---
# Gol = fără login (serverul de pe PC). Pe VM pune și HOST=127.0.0.1.
# APP_PASSWORD=

# --- Doar pe VM (collector.py) ---
# QUESTDB_HOST=localhost
# COLLECT_SYMBOLS=EURUSD,XAUUSD
# COLLECT_START=2026-01-01
# QUESTDB_DATA_DIR=C:\questdb\data

# --- E-mail pentru alarme (SMTP) ---
# Gmail: activează verificarea în 2 pași, apoi creează o „Parolă pentru aplicații”
# la https://myaccount.google.com/apppasswords și pune-o la SMTP_PASSWORD
# (NU parola contului Google).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=adresa.ta@gmail.com
SMTP_PASSWORD=
SMTP_FROM=adresa.ta@gmail.com
# Numele afișat la expeditor (implicit „Nexus Alerts”)
SMTP_FROM_NAME=Nexus Alerts

# Outlook / Hotmail: SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587  SMTP_SECURITY=starttls
# Yahoo:            SMTP_HOST=smtp.mail.yahoo.com    SMTP_PORT=465  SMTP_SECURITY=ssl
