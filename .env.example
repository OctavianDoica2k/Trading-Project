# =====================================================================================
#  Setările aplicației Verax
# -------------------------------------------------------------------------------------
#  1. Copiază acest fișier ca .env (în același folder):   copy .env.example .env
#  2. Completează valorile de mai jos. Ce rămâne gol primește valoarea implicită.
#  3. Fișierul .env conține parole: rămâne doar pe calculatorul tău (e în .gitignore,
#     deci nu ajunge niciodată pe GitHub). Nu pune parole în acest fișier exemplu.
# =====================================================================================

# --- Serverul web (server.py) ---
# 0.0.0.0 = pagina se deschide și de pe telefon, din aceeași rețea Wi-Fi
# 127.0.0.1 = pagina se deschide doar de pe acest calculator
HOST=0.0.0.0
PORT=8000

# --- Baza de date QuestDB (obligatoriu) ---
# Adresa calculatorului pe care rulează QuestDB: localhost dacă e pe același calculator,
# altfel adresa lui (de ex. IP-ul din Tailscale al mașinii virtuale).
QUESTDB_HOST=localhost
# Verax vorbește cu QuestDB doar prin HTTP (portul 9000). Pe un QuestDB proaspăt instalat accesul
# HTTP nu cere parolă: lasă cele două rânduri goale. Dacă activezi autentificarea în QuestDB
# (http.user / http.password în conf/server.conf), pune aici aceleași valori.
QUESTDB_USER=
QUESTDB_PASSWORD=

# --- cTrader Open API (obligatoriu pentru colector și ctrader_setup.py) ---
# Creează o aplicație la https://openapi.ctrader.com/apps (cu cTrader ID-ul tău; un cont demo
# e suficient) și copiază aici Client ID și Secret.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# --- Colectorul de ticuri (collector.py) ---
# Simbolurile salvate în QuestDB și data de la care se descarcă istoricul de ticuri.
# O zi de ticuri EURUSD ≈ 65 000 de ticuri; câțiva ani de istoric durează ore la prima rulare.
# COLLECT_SYMBOLS=EURUSD,XAUUSD
# COLLECT_START=2026-01-01
# Folderul de date al QuestDB (colectorul verifică spațiul liber de pe disc).
# QUESTDB_DATA_DIR=C:\questdb\data

# --- Parolă pentru pagină (opțional) ---
# Gol = fără login (potrivit când serverul e accesibil doar de pe calculatorul tău).
# Pune o parolă dacă publici aplicația pe internet (de ex. prin ngrok) și setează HOST=127.0.0.1.
# APP_PASSWORD=

# --- Adresa HTTPS a aplicației (opțional) ---
# Notificările push merg doar pe HTTPS (sau pe localhost). Dacă ai o adresă HTTPS
# (Tailscale Serve, ngrok etc.), pune-o aici: pagina o recomandă când e deschisă fără HTTPS.
# HTTPS_URL=https://numele-tau.ts.net

# --- E-mail pentru alarme (opțional, SMTP) ---
# Fără aceste setări, alarmele apar doar în pagină. Pentru Gmail: activează verificarea în
# 2 pași, apoi creează o „Parolă pentru aplicații” la https://myaccount.google.com/apppasswords
# și pune-o la SMTP_PASSWORD (NU parola contului Google).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=adresa.ta@gmail.com
SMTP_PASSWORD=
SMTP_FROM=adresa.ta@gmail.com
# Numele afișat la expeditor (implicit „Verax Alerts”)
SMTP_FROM_NAME=Verax Alerts

# Outlook / Hotmail: SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587  SMTP_SECURITY=starttls
# Yahoo:            SMTP_HOST=smtp.mail.yahoo.com    SMTP_PORT=465  SMTP_SECURITY=ssl
